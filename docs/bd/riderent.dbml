Project RideRent {
  database_type: 'PostgreSQL'
  Note: 'Challenge 1 logical model; production implementation should enforce constraints server-side.'
}

Table users {
  id int [pk, increment]
  name varchar(120) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, note: 'customer | admin']
  created_at timestamp [not null]
}

Table vehicles {
  id int [pk, increment]
  name varchar(120) [not null]
  category varchar(30) [not null]
  seats int [not null]
  price_per_day decimal(10,2) [not null]
  transmission varchar(30) [not null]
  fuel varchar(30) [not null]
  location varchar(120) [not null]
  active boolean [not null]
}

Table reservations {
  id int [pk, increment]
  user_id int [not null]
  vehicle_id int [not null]
  start_date date [not null]
  end_date date [not null]
  status varchar(20) [not null]
  created_at timestamp [not null]
}

Table shared_rides {
  id int [pk, increment]
  driver_id int [not null]
  origin varchar(120) [not null]
  destination varchar(120) [not null]
  ride_date date [not null]
  departure_time time [not null]
  available_seats int [not null]
  contribution decimal(10,2) [not null]
  status varchar(20) [not null]
}

Table ride_participants {
  id int [pk, increment]
  ride_id int [not null]
  user_id int [not null]
  joined_at timestamp [not null]
  indexes { (ride_id, user_id) [unique] }
}

Ref: reservations.user_id > users.id
Ref: reservations.vehicle_id > vehicles.id
Ref: shared_rides.driver_id > users.id
Ref: ride_participants.ride_id > shared_rides.id
Ref: ride_participants.user_id > users.id
